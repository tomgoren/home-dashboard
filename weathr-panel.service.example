[Unit]
Description=weathr-panel weather appliance
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/weathr-panel
ExecStart=/home/pi/weathr-panel/.venv/bin/python -m app.main
Restart=on-failure
RestartSec=3
# Needed for direct DRM/KMS + input access without a desktop session.
SupplementaryGroups=video input render

[Install]
WantedBy=multi-user.target
